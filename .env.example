OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
TOKENROUTER_API_KEY=
OPENCODE_API_KEY=

# ArangoDB (see docker-compose.yml). ARANGO_ROOT_PASSWORD is read by the
# container itself; ARANGO_PASSWORD is what the app uses to connect as
# ARANGO_USERNAME — keep them equal for the default root-user setup.
ARANGO_ROOT_PASSWORD=changeme
ARANGO_HOST=http://localhost:8529
ARANGO_USERNAME=root
ARANGO_PASSWORD=changeme

UVICORN_PORT=8000